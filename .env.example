# LOCAL LENS INDIA — Environment Configuration Template
# Copy this file to .env and configure with your credentials

# Django Configuration
DEBUG=True
DJANGO_SECRET_KEY=local-lens-india-dev-secret-key-2026-experience-like-a-local

# AI Provider 1: Google Gemini API (Primary Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI Request Timeout (seconds)
AI_REQUEST_TIMEOUT=60

# AI Provider 2: Ollama Local Models (Automatic Local Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# Data Provider Disk Cache TTL (seconds - default: 24 hours)
DATA_CACHE_TTL=86400
